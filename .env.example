# Токен бота: https://discord.com/developers/applications -> ваше приложение -> Bot -> Reset Token
DISCORD_TOKEN=

# ID вашего сервера — если задать, слэш-команды появятся мгновенно (для разработки).
# Если оставить пустым, команды синхронизируются глобально (обновление до ~1 часа).
GUILD_ID=

# Путь к файлу базы данных SQLite внутри контейнера (не меняйте, если используете docker-compose как есть)
DB_PATH=data/bot.db

# Ключ NordRouter (sk-nr-…). Через него идут ChatGPT, Claude, Gemini и Nano Banana.
# Если nordrouter.com недоступен, можно указать https://global-api.nordrouter.com/v1
NORDROUTER_API_KEY=
NORDROUTER_BASE_URL=https://nordrouter.com/v1

# ID моделей из каталога NordRouter. Меняйте, если нужна другая версия.
CHATGPT_MODEL=openai/gpt-5.4-mini
CLAUDE_MODEL=anthropic/claude-sonnet-4.6
GEMINI_MODEL=google/gemini-3.5-flash
NANO_BANANA_MODEL=google/gemini-3.1-flash-image-preview

# Настройки голосований по умолчанию (можно переопределить командой /pozor setup для каждого сервера)
VOTE_THRESHOLD=3
VOTE_DURATION_HOURS=24
# Пауза после снятия позора, прежде чем по человеку снова можно голосовать (0 — без паузы)
POZOR_COOLDOWN_HOURS=6

# Названия ролей для прав на редактирование ролей (можно переопределить командой /role setup)
ROLE_ADMIN_NAME=админ
ROLE_TRUSTED_NAME=бро <3
ROLE_EDIT_WINDOW_HOURS=24
